APP_NAME="RentACar SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=rentacar_db
# DB_USERNAME=rentacar_user
# DB_PASSWORD=secret

# Tenancy hosts (override in production with real domains)
ADMIN_PANEL_DOMAIN=admin.localhost
TENANT_BASE_DOMAIN=localhost
CENTRAL_DOMAIN=localhost

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Scope the session cookie to the PARENT domain (leading dot) so it is shared
# across the admin panel (admin.<domain>) and every tenant subdomain. Required
# for operator impersonation to survive the redirect from admin. to the tenant
# subdomain. In production set e.g. SESSION_DOMAIN=.yourdomain.com.
# NOTE: a leading-dot ".localhost" cookie is rejected by browsers — for local
# cross-subdomain testing use a resolvable base domain such as .lvh.me.
# The admin "Log in as operator" (impersonation) action is HIDDEN while this is
# unset, since the session cannot carry across subdomains without it.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend transport (set MAIL_MAILER=resend to use). RESEND_WEBHOOK_SECRET is the
# Svix signing secret (whsec_...) from the Resend webhook dashboard, used to
# verify inbound delivery webhooks that update the email delivery log.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# GitHub Models (OpenAI-compatible). Token = a GitHub PAT with the models scope.
GITHUB_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1
